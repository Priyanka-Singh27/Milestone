# ============================ server/.env.example ============================
# Copy to server/.env for local development. On Render/any host, set these as
# environment variables instead. NEVER commit a real .env file.
# The server refuses to start if a required value is missing or too weak.

NODE_ENV=development
PORT=5000

# --- Database (MongoDB Atlas connection string) ---
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/milestone?retryWrites=true&w=majority

# --- Secrets (generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
INTERNAL_API_KEY=change-me-to-a-different-long-random-string
# Optional: separate key for encrypting stored Google refresh tokens (defaults to JWT_SECRET)
TOKEN_ENCRYPTION_KEY=

# --- Frontend origin(s). Comma-separated, NO trailing slash, NO path. ---
# Used for CORS and for redirects after Google sign-in / Sheets connect.
FRONTEND_URL=http://localhost:5173

# --- How the server calls itself (quiz -> badge, dashboard -> modules). ---
# Works with or without a trailing /api/v1.
INTERNAL_API_URL=http://localhost:5000

# --- AI model (Groq) ---
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_MODEL=
# Use LLM_PROVIDER=mock for offline local testing only (rejected in production).

# --- Google sign-in + Sheets sync (optional; both are disabled if unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must also be added to "Authorized redirect URIs" in Google Cloud Console:
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
# Sheets uses its own redirect URI (also add it in Google Cloud Console).
# Defaults to GOOGLE_REDIRECT_URI with /auth/google/callback -> /applications/sheets/callback
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:5000/api/v1/applications/sheets/callback

# --- Certificate uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
