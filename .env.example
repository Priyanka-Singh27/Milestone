# server/.env.example
# Copy this file to server/.env and fill in the values.
# Never commit .env — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=              # MongoDB Atlas connection string (shared dev DB owned by Person D)

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=                # Long random string — generate with: node -e "require('crypto').randomBytes(64).toString('hex')|console.log"
                           # Server refuses to start if this is missing.

# ── Internal service-to-service calls ─────────────────────────────────────────
INTERNAL_API_KEY=          # Shared secret used by the Quiz system when calling /skills/verify
                           # and /certificates/badge. Generate the same way as JWT_SECRET.
INTERNAL_API_URL=http://localhost:5000/api/v1
                           # URL the Dashboard controller uses to call the other modules.
                           # In production this is the Render backend URL.

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
                           # Comma-separated list allowed for multi-origin.
                           # E.g. "http://localhost:3000,https://my-app.vercel.app"
                           # Used for CORS and Google OAuth redirect.

# ── LLM provider (Person A owns these credentials) ───────────────────────────
LLM_API_KEY=               # API key — do NOT name this ANTHROPIC_API_KEY or GROQ_API_KEY
LLM_PROVIDER=              # "groq" | "anthropic" | "mock" — llm.service.js reads this

# ── Google OAuth (shared Google Cloud project — Person C owns it) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=       # e.g. http://localhost:5000/api/v1/auth/google/callback

# ── Object storage (Person C owns — S3 or Cloudinary) ────────────────────────
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Local development ─────────────────────────────────────────────────────────
PORT=5000
DEV_USER_PASSWORD=         # Password for the dev-user-1 seed account.
                           # Defaults to "devpassword123" if unset (local only).
NODE_ENV=development       # Set to "production" on Render